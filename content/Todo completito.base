filters:
  and:
    - '!file.name.startsWith("Template")'
views:
  - type: table
    name: Tabla
    filters:
      and:
        - file.hasTag("átomo")
    order:
      - file.name
      - file.size
    sort:
      - property: file.name
        direction: DESC
      - property: file.size
        direction: ASC
  - type: table
    name: átomos
    filters:
      and:
        - file.hasTag("átomo")
    order:
      - file.name
      - rank
